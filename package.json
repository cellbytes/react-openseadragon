{
  "name": "@cellbytes/react-openseadragon",
  "version": "1.1.1",
  "description": "A thin, declarative React wrapper around OpenSeadragon: hooks, components, and a small plugin mechanism.",
  "keywords": [
    "deep-zoom",
    "dzi",
    "hooks",
    "image-viewer",
    "openseadragon",
    "react"
  ],
  "homepage": "https://github.com/cellbytes/react-openseadragon#readme",
  "bugs": {
    "url": "https://github.com/cellbytes/react-openseadragon/issues"
  },
  "license": "EUPL-1.2",
  "author": "Cellbytes",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cellbytes/react-openseadragon.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "./src/index.ts",
    "./dist/index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint . && oxfmt --check .",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "lefthook install",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.64.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.0.5",
    "lefthook": "^2.2.2",
    "openseadragon": "^6.1.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2004",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "semantic-release": "^25.0.9",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "openseadragon": ">=6",
    "react": ">=19"
  },
  "engines": {
    "node": ">=24"
  }
}
